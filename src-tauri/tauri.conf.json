{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StayInsured",
  "version": "0.1.0",
  "identifier": "com.stayinsured.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "StayInsured",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/documents/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "StayInsured",
    "category": "Business",
    "shortDescription": "Insurance client and policy management",
    "longDescription": "Track clients, policies and renewals, send expiry reminders, and report on your book of business. All data stays on this machine in an encrypted database."
  },
  "plugins": {}
}
