{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StayInsured",
  "version": "0.3.1",
  "identifier": "com.stayinsured.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "StayInsured",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' blob: data:; frame-src blob:; object-src blob:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "StayInsured",
    "category": "Business",
    "shortDescription": "Insurance client and policy management",
    "longDescription": "Track clients, policies and renewals, send expiry reminders, and report on your book of business. All data stays on this machine in an encrypted database."
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/laksagent-png/StayInsured/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVFNUY5RjRDQjI1NkI5MDAKUldRQXVWYXlUSjlmWGlpMHMwUGk0Y3JaYUZPVTF3bkIrd0loMENCQmYyNExQSXM0dXFPQ0JmMHoK"
    }
  }
}
