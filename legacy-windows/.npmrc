# Native modules here must match Electron's ABI, not the ABI of whatever Node is
# on the machine doing the install. Without this, `better-sqlite3` builds against
# local Node headers and either fails outright or produces a binary Electron
# cannot load.
#
# Electron 22 is the last release supporting Windows 7. It carries Node 16 but
# numbers its own ABI separately, as module version 110, which is why
# better-sqlite3 stays on its 8.x line: that is the line with prebuilt binaries
# for it, on win32-x64 and win32-ia32 alike.
runtime = electron
target = 22.3.27
disturl = https://electronjs.org/headers
